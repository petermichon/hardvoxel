# Canonical production URL used in canonicals, social images, and schema.
# Keep this as the production URL for staging so previews do not compete with
# production in search. Change it only if the production domain changes.
VITE_SITE_URL=https://hardvoxel.com

# Set to "true" on staging or preview deployments. This adds a sitewide
# noindex meta tag. Also send an X-Robots-Tag: noindex header at the edge.
VITE_NOINDEX=false
